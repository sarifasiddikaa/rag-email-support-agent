        "operation": "sendAndWait",
        "sendTo": "sstrinaa@gmail.com",
        "subject": "=[Approval needed] Reply to {{ $('Normalize Email').item.json.customerEmail }}",
        "message": "=A customer email was drafted by the AI support agent. Review it before it goes out.\n\nFROM: {{ $('Normalize Email').item.json.customerEmail }}\nSUBJECT: {{ $('Normalize Email').item.json.subject }}\n\nCUSTOMER WROTE:\n{{ $('Normalize Email').item.json.body }}\n\n----- AI DRAFT -----\n{{ $json.output.reply }}\n--------------------\n\nCategory: {{ $json.output.category }}\nConfidence: {{ $json.output.confidence }}\nAgent flagged for human: {{ $json.output.needs_human }}\nKnowledge used: {{ $json.output.sources_used }}\n\nApprove to send this reply to the customer. Reject to save it as a Gmail draft for manual editing.",
